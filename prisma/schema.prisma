generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {

  id Int @id @default(autoincrement())

  orderId String @unique

  game String
  userId String
  extraId String?

  item String
  price Int

  payment String

  productCode String?

  status String @default("PENDING")

  transactionStatus String @default("PENDING")

  vipTrxId String?

  vipStatus String?

  note String?

  createdAt DateTime @default(now())

}